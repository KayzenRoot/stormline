# NLE-CORE01-QUAL-002: test-only, native executable provenance, NOT a public ABI.
cmake_minimum_required(VERSION 3.27)
if(NOT DEFINED STORM_ABI_BINARY OR STORM_ABI_BINARY STREQUAL "" OR
   NOT STORM_ABI_PLATFORM MATCHES "^(Linux|Windows|Darwin)$")
    message(FATAL_ERROR "ABI_FAIL required binary/platform arguments")
endif()
if(NOT DEFINED STORM_ABI_MODE)
    set(STORM_ABI_MODE verify)
endif()
if(STORM_ABI_MODE STREQUAL "negative")
    set(_bad "${STORM_ABI_BINARY}.abi-invalid")
    file(WRITE "${_bad}" "NO_NATIVE_BINARY\n")
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DSTORM_ABI_BINARY=${_bad}" "-DSTORM_ABI_PLATFORM=${STORM_ABI_PLATFORM}"
        "-DSTORM_ABI_MODE=verify" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE _rc ERROR_VARIABLE _err OUTPUT_VARIABLE _out TIMEOUT 15)
    file(REMOVE "${_bad}")
    if("${_rc}" STREQUAL "0" OR
       NOT _err MATCHES "ABI_FAIL invalid native file signature")
        message(FATAL_ERROR "ABI_FAIL invalid-image negative oracle did not reject the expected failure: ${_err}")
    endif()
    message(STATUS "ABI_NEGATIVE_OK malformed_binary=rejected")
    return()
endif()
if(NOT STORM_ABI_MODE STREQUAL "verify")
    message(FATAL_ERROR "ABI_FAIL unexpected mode")
endif()
if(NOT EXISTS "${STORM_ABI_BINARY}" OR IS_DIRECTORY "${STORM_ABI_BINARY}")
    message(FATAL_ERROR "ABI_FAIL missing real test executable")
endif()
file(READ "${STORM_ABI_BINARY}" _signature OFFSET 0 LIMIT 4 HEX)
string(TOLOWER "${_signature}" _signature)
if(STORM_ABI_PLATFORM STREQUAL "Linux" AND NOT _signature STREQUAL "7f454c46")
    message(FATAL_ERROR "ABI_FAIL invalid native file signature: required ELF")
elseif(STORM_ABI_PLATFORM STREQUAL "Windows" AND NOT _signature MATCHES "^4d5a")
    message(FATAL_ERROR "ABI_FAIL invalid native file signature: required PE")
elseif(STORM_ABI_PLATFORM STREQUAL "Darwin" AND NOT _signature STREQUAL "cffaedfe")
    message(FATAL_ERROR "ABI_FAIL invalid native file signature: required arm64 Mach-O")
endif()
file(SHA256 "${STORM_ABI_BINARY}" _sha)
file(SIZE "${STORM_ABI_BINARY}" _bytes)
if(NOT _sha MATCHES "^[0-9a-fA-F]+$" OR NOT _bytes GREATER 0)
    message(FATAL_ERROR "ABI_FAIL SHA256 or size invalid")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --version
    RESULT_VARIABLE _cmake_rc OUTPUT_VARIABLE _cmake_out TIMEOUT 10)
find_program(_ninja NAMES ninja)
if(NOT _ninja OR NOT "${_cmake_rc}" STREQUAL "0")
    message(FATAL_ERROR "ABI_FAIL CMake/Ninja not observed")
endif()
execute_process(COMMAND "${_ninja}" --version
    RESULT_VARIABLE _ninja_rc OUTPUT_VARIABLE _ninja_ver TIMEOUT 10)
if(NOT "${_ninja_rc}" STREQUAL "0" OR NOT _ninja_ver MATCHES "^[0-9]+[.][0-9]+")
    message(FATAL_ERROR "ABI_FAIL Ninja version invalid")
endif()
string(REGEX MATCH "cmake version [^\r\n]+" _cmake_ver "${_cmake_out}")
string(STRIP "${_ninja_ver}" _ninja_ver)
message(STATUS "ABI_RECEIPT_SHA256=${_sha} bytes=${_bytes}")
message(STATUS "ABI_TOOLCHAIN target=${STORM_ABI_PLATFORM} compiler=${STORM_ABI_COMPILER_ID} version=${STORM_ABI_COMPILER_VERSION} cmake=${_cmake_ver} ninja=${_ninja_ver}")
message(STATUS "ABI_LIMIT external_abi=NOT_DEFINED cross_toolchain_binary_compat=NOT_QUALIFIED g3_global=NOT_CLEARED")
if(STORM_ABI_PLATFORM STREQUAL "Linux")
    find_program(_readelf NAMES readelf)
    if(NOT _readelf)
        message(FATAL_ERROR "ABI_FAIL readelf missing")
    endif()
    execute_process(COMMAND "${_readelf}" -W -h "${STORM_ABI_BINARY}"
        RESULT_VARIABLE _hdr_rc OUTPUT_VARIABLE _hdr ERROR_VARIABLE _hdr_err TIMEOUT 15)
    if(NOT "${_hdr_rc}" STREQUAL "0" OR NOT _hdr MATCHES "ELF64" OR
       NOT _hdr MATCHES "Advanced Micro Devices X86-64")
        message(FATAL_ERROR "ABI_FAIL ELF64/x86_64 header: ${_hdr_err}")
    endif()
    # Inspect separately: -n note decoding is optional and must not invalidate
    # a valid dynamic table. Dynamic imports and version-info remain mandatory.
    execute_process(COMMAND "${_readelf}" -W -d "${STORM_ABI_BINARY}"
        RESULT_VARIABLE _dep_rc OUTPUT_VARIABLE _dep ERROR_VARIABLE _dep_err TIMEOUT 15)
    execute_process(COMMAND "${_readelf}" -W --version-info "${STORM_ABI_BINARY}"
        RESULT_VARIABLE _ver_rc OUTPUT_VARIABLE _versions ERROR_VARIABLE _ver_err TIMEOUT 15)
    execute_process(COMMAND "${_readelf}" -W -n "${STORM_ABI_BINARY}"
        RESULT_VARIABLE _note_rc OUTPUT_VARIABLE _notes ERROR_VARIABLE _note_err TIMEOUT 15)
    if(NOT "${_dep_rc}" STREQUAL "0" OR NOT "${_ver_rc}" STREQUAL "0" OR
       NOT _dep MATCHES "NEEDED")
        string(LENGTH "${_dep}" _dep_len)
        string(LENGTH "${_versions}" _versions_len)
        message(FATAL_ERROR "ABI_FAIL real ELF dynamic/version information missing: dynamic_rc=${_dep_rc} versions_rc=${_ver_rc} dep_bytes=${_dep_len} ver_bytes=${_versions_len} dynamic_err=${_dep_err} versions_err=${_ver_err}")
    endif()
    string(REGEX MATCHALL "GLIBC_[0-9]+([.][0-9]+)+" _glibc "${_versions}")
    string(REGEX MATCHALL "GLIBCXX_[0-9]+([.][0-9]+)+" _glibcxx "${_versions}")
    if(NOT _glibc OR NOT _glibcxx)
        message(FATAL_ERROR "ABI_FAIL actual GLIBC/GLIBCXX symbol requirements not observed")
    endif()
    list(REMOVE_DUPLICATES _glibc)
    list(REMOVE_DUPLICATES _glibcxx)
    list(SORT _glibc COMPARE NATURAL ORDER DESCENDING)
    list(SORT _glibcxx COMPARE NATURAL ORDER DESCENDING)
    list(GET _glibc 0 _glibc_max)
    list(GET _glibcxx 0 _glibcxx_max)
    string(REGEX MATCHALL "Shared library: [[][^]\r\n]+[]]" _libs "${_dep}")
    string(REPLACE ";" "," _libs "${_libs}")
    message(STATUS "ABI_ELF_OK class=ELF64 machine=x86_64 max_required_GLIBC=${_glibc_max} max_required_GLIBCXX=${_glibcxx_max}")
    message(STATUS "ABI_ELF_NEEDED=${_libs}")
    if("${_note_rc}" STREQUAL "0" AND _notes MATCHES "x86 ISA needed")
        string(REGEX MATCH "x86 ISA needed: [^\r\n]+" _isa "${_notes}")
        message(STATUS "ABI_ELF_DECLARED_ISA=${_isa}")
    else()
        message(STATUS "ABI_ELF_DECLARED_ISA=NOT_QUALIFIED_NO_GNU_NOTE_AVX_NOT_PROVEN note_rc=${_note_rc}")
    endif()
    message(STATUS "ABI_ELF_RUNTIME_GLIBC_FLOOR=NOT_QUALIFIED_OTHER_DISTROS_NOT_RUN")
elseif(STORM_ABI_PLATFORM STREQUAL "Windows")
    find_program(_dumpbin NAMES dumpbin.exe dumpbin)
    if(NOT _dumpbin)
        message(FATAL_ERROR "ABI_FAIL preinstalled dumpbin unavailable")
    endif()
    execute_process(COMMAND "${_dumpbin}" /HEADERS "${STORM_ABI_BINARY}"
        RESULT_VARIABLE _hdr_rc OUTPUT_VARIABLE _hdr ERROR_VARIABLE _hdr_err TIMEOUT 20)
    execute_process(COMMAND "${_dumpbin}" /IMPORTS "${STORM_ABI_BINARY}"
        RESULT_VARIABLE _dep_rc OUTPUT_VARIABLE _imports ERROR_VARIABLE _dep_err TIMEOUT 20)
    if(NOT "${_hdr_rc}" STREQUAL "0" OR NOT "${_dep_rc}" STREQUAL "0" OR
       NOT _hdr MATCHES "8664 machine [(]x64[)]")
        message(FATAL_ERROR "ABI_FAIL PE x64 header/imports not proven: ${_hdr_err} ${_dep_err}")
    endif()
    string(TOUPPER "${_imports}" _imports_upper)
    string(REGEX MATCHALL "[A-Z0-9_.-]+[.]DLL" _dlls "${_imports_upper}")
    if(NOT _dlls OR NOT _imports_upper MATCHES "VCRUNTIME|UCRTBASE|MSVCP|API-MS-WIN-CRT")
        message(FATAL_ERROR "ABI_FAIL PE CRT imports not verified")
    endif()
    list(REMOVE_DUPLICATES _dlls)
    string(REPLACE ";" "," _dlls "${_dlls}")
    message(STATUS "ABI_PE_OK machine=x64 dll_imports=${_dlls}")
    if(DEFINED ENV{WindowsSDKVersion} AND NOT "$ENV{WindowsSDKVersion}" STREQUAL "")
        message(STATUS "ABI_PE_SDK_ENV=$ENV{WindowsSDKVersion}")
    else()
        message(STATUS "ABI_PE_SDK_ENV=NOT_QUALIFIED")
    endif()
    if(DEFINED ENV{VCToolsVersion} AND NOT "$ENV{VCToolsVersion}" STREQUAL "")
        message(STATUS "ABI_PE_MSVC_TOOLSET_ENV=$ENV{VCToolsVersion}")
    else()
        message(STATUS "ABI_PE_MSVC_TOOLSET_ENV=NOT_QUALIFIED")
    endif()
    message(STATUS "ABI_PE_CRT_REDISTRIBUTION_FLOOR=NOT_QUALIFIED")
elseif(STORM_ABI_PLATFORM STREQUAL "Darwin")
    find_program(_otool NAMES otool)
    find_program(_lipo NAMES lipo)
    find_program(_xcrun NAMES xcrun)
    find_program(_xcodebuild NAMES xcodebuild)
    if(NOT _otool OR NOT _lipo OR NOT _xcrun OR NOT _xcodebuild)
        message(FATAL_ERROR "ABI_FAIL missing Apple preinstalled inspection tools")
    endif()
    execute_process(COMMAND "${_lipo}" -archs "${STORM_ABI_BINARY}"
        RESULT_VARIABLE _arch_rc OUTPUT_VARIABLE _arch ERROR_VARIABLE _arch_err TIMEOUT 20)
    execute_process(COMMAND "${_otool}" -l "${STORM_ABI_BINARY}"
        RESULT_VARIABLE _hdr_rc OUTPUT_VARIABLE _load ERROR_VARIABLE _load_err TIMEOUT 20)
    if(NOT "${_arch_rc}" STREQUAL "0" OR NOT "${_hdr_rc}" STREQUAL "0" OR
       NOT _arch MATCHES "arm64" OR NOT _load MATCHES "cmd LC_BUILD_VERSION")
        message(FATAL_ERROR "ABI_FAIL arm64 Mach-O header or LC_BUILD_VERSION not proven")
    endif()
    string(REGEX MATCH "minos[ \t]+[0-9.]+" _minos "${_load}")
    string(REGEX MATCH "sdk[ \t]+[0-9.]+" _sdk "${_load}")
    if(NOT _minos OR NOT _sdk)
        message(FATAL_ERROR "ABI_FAIL missing Mach-O minimum OS and SDK build metadata")
    endif()
    execute_process(COMMAND "${_otool}" -L "${STORM_ABI_BINARY}"
        RESULT_VARIABLE _link_rc OUTPUT_VARIABLE _libs ERROR_VARIABLE _link_err TIMEOUT 20)
    execute_process(COMMAND "${_xcrun}" --show-sdk-version
        RESULT_VARIABLE _sdk_rc OUTPUT_VARIABLE _host_sdk ERROR_VARIABLE _sdk_err TIMEOUT 20)
    execute_process(COMMAND "${_xcodebuild}" -version
        RESULT_VARIABLE _xcode_rc OUTPUT_VARIABLE _xcode ERROR_VARIABLE _xcode_err TIMEOUT 20)
    if(NOT "${_link_rc}" STREQUAL "0" OR NOT _libs MATCHES "libSystem" OR
       NOT "${_sdk_rc}" STREQUAL "0" OR NOT "${_xcode_rc}" STREQUAL "0")
        message(FATAL_ERROR "ABI_FAIL Apple SDK/Xcode and linked dylibs not observed")
    endif()
    string(STRIP "${_arch}" _arch)
    string(STRIP "${_host_sdk}" _host_sdk)
    string(REPLACE "\n" " " _xcode "${_xcode}")
    string(REGEX MATCHALL "/[^ \t\r\n]+[.]dylib" _dylibs "${_libs}")
    if(NOT _dylibs)
        message(FATAL_ERROR "ABI_FAIL no Mach-O dylib imports recognized")
    endif()
    list(REMOVE_DUPLICATES _dylibs)
    string(REPLACE ";" "," _dylibs "${_dylibs}")
    message(STATUS "ABI_MACHO_OK arch=${_arch} ${_minos} ${_sdk} host_sdk=${_host_sdk} xcode=${_xcode}")
    message(STATUS "ABI_MACHO_LIBRARIES=${_dylibs}")
    message(STATUS "ABI_MACOS_PHYSICAL_MINIMUM_RUNTIME=NOT_QUALIFIED")
endif()
message(STATUS "ABI_NATIVE_PROBE_OK internal_only=YES no_public_abi=YES")
